# DASHDUEL game server: environment template.
# Copy to a real environment (your host's "Environment variables" page, a systemd unit, `docker run -e ...`).
# The server does NOT read a .env file by itself (zero dependencies): set these as real environment variables,
# e.g. `export $(grep -v '^#' .env | xargs) && node server/server.js` on Linux.
#
# NOTHING in this file is a real secret. Generate your own SESSION_SECRET / ADMIN_TOKEN and keep them out of git
# and out of the browser files (js/ is public).

# ---- networking --------------------------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Websites allowed to open a game socket (exact origins, comma separated, no path). REQUIRED in production.
# Empty = local development only. "*" = anyone (not recommended).
ALLOWED_ORIGINS=https://your-game.example.com
# 1 behind Render / Fly / Railway / nginx / Caddy: use X-Forwarded-For for the real IP and X-Forwarded-Proto for TLS.
TRUST_PROXY=1
# 1 = refuse plain ws:// (clients must come in over TLS, i.e. wss://). Turn this on in production.
REQUIRE_TLS=1
# 1 = also serve index.html, css/, js/, vendor/ from this process (single-service hosting / local play)
SERVE_STATIC=0
MAX_CONNECTIONS=400
MAX_PER_IP=6

# ---- security ----------------------------------------------------------------------------------------------
# Signs the session tokens (needed to resume a match after a dropped connection). At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If you leave it empty a random one is made at start-up (tokens stop working after a restart).
SESSION_SECRET=
# 1 = enable GET /debug/anticheat and GET /debug/rooms (no tokens, no addresses). Keep OFF on a public server unless
# ADMIN_TOKEN is set; the endpoints then need "Authorization: Bearer <ADMIN_TOKEN>". With no ADMIN_TOKEN they answer
# only requests from the same machine.
DEBUG_ENDPOINTS=0
ADMIN_TOKEN=

# ---- logging -----------------------------------------------------------------------------------------------
LOG_LEVEL=info          # info | debug | quiet   (security events are always logged)
LOG_FORMAT=json         # json (one object per line, easy to ship/grep) | text

# ---- reconnect / rematch -----------------------------------------------------------------------------------
RECONNECT_GRACE_S=15    # a dropped player keeps their place this long (the round clock and fights pause)
REMATCH_WINDOW_S=20     # after a match both players may agree to a rematch for this long
SESSION_IDLE_S=60       # a session with no connection and no match is forgotten after this
MAX_SESSIONS=4000

# ---- anti-cheat thresholds (defaults shown; see docs/ONLINE_BACKEND.md for what each one means) -----------------
AC_WARN_SCORE=40        # violation score that triggers a warning to the client
AC_KICK_SCORE=100       # ... and a disconnect
AC_DECAY=1              # score points forgotten per second
AC_LOCKOUT_S=60         # a kicked session/address cannot queue for this long (never permanent)
AC_MAX_TURN_RATE=80     # rad/s of view turning accepted (a very fast human flick is ~30)
AC_CLAIM_EPS=0.05       # m: client-predicted position vs the server simulation before a correction is sent
AC_INPUT_BURST_STEPS=45 # steps (1/120 s) simulated in one go after a stall
AC_CATCHUP=1.5          # backlog after a stall is worked off this much faster than real time
AC_INPUT_SLACK_STEPS=360 # input a client may be ahead of the round clock (speed-hack limit), 3 s
AC_INPUT_QUEUE_MAX=720  # queued, not yet simulated steps (memory guard)
AC_FIRE_TOLERANCE=0.9   # a shot may come at 90% of the weapon's interval (frame granularity)
LAG_MAX_REWIND_MS=350   # lag compensation never rewinds further than this
VIS_CULLING=1           # 0 = always send the opponent's position (debugging only)

# ---- NEVER set these on a public server --------------------------------------------------------------------
# TEST_MODE=1           # enables the test-only teleport / state-dump messages used by the automated tests
